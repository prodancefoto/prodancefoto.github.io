# CSS / JS：短缓存。改版后几分钟内即可生效，
# 避免长期缓存 + 同名路径导致「新版 HTML 配旧版 CSS」。
/assets/*.css
  Cache-Control: public, max-age=300
/assets/*.js
  Cache-Control: public, max-age=300

# 图片 / 字体等静态资源：内容极少变动，长期缓存
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML 页面（根目录与作品集子目录）：短缓存，保证文案/作品改动快速同步到线上与 AI 爬虫
/*.html
  Cache-Control: public, max-age=300

/works/*.html
  Cache-Control: public, max-age=300

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
